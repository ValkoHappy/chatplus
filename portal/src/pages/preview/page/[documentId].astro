---
export const prerender = false;

import PageV2Page from '../../../components/PageV2Page.astro';
import { getPageV2DraftByDocumentId, isPreviewTokenValid } from '../../../lib/strapi';

const { documentId } = Astro.params;
const token = Astro.url.searchParams.get('token');

Astro.response.headers.set('Cache-Control', 'no-store, private');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

if (!isPreviewTokenValid(token)) {
  return new Response('Unauthorized preview', { status: 401 });
}

const page = await getPageV2DraftByDocumentId(documentId || '');

if (!page) {
  return new Response('Draft page not found', { status: 404 });
}
---

<PageV2Page page={{ ...page, robots: 'noindex,nofollow' }} />

<style is:global>
  body::before {
    content: 'Preview draft';
    position: fixed;
    z-index: 9999;
    right: 1rem;
    bottom: 1rem;
    padding: .45rem .7rem;
    border-radius: 999px;
    color: #0f172a;
    background: #facc15;
    border: 1px solid rgba(15, 23, 42, .18);
    font: 700 .78rem/1.1 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    box-shadow: 0 10px 30px rgba(15, 23, 42, .18);
  }
</style>
