---
const { section, pageKind = '' } = Astro.props as { section: Record<string, any>; pageKind?: string };
const items = Array.isArray(section.items) ? section.items : [];
const variant = section.variant || 'cards';
const isEvenCardGrid = variant === 'cards' && items.length === 4;
const isResourcePage = pageKind === 'resource';
---

{items.length > 0 && (
  <section class="section">
    <div class:list={['container', isResourcePage && 'pagev2-steps-container--resource']}>
      {(section.title || section.intro) && (
        <div class="section-header">
          {section.title && <h2>{section.title}</h2>}
          {section.intro && <p>{section.intro}</p>}
        </div>
      )}
      <div class:list={['pagev2-steps', `pagev2-steps--${variant}`, isEvenCardGrid && 'pagev2-steps--two-by-two', isResourcePage && 'pagev2-steps--resource']}>
        {items.map((item, index) => (
          <article class="pagev2-step">
            <span class="pagev2-step__index">{index + 1}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .pagev2-steps {
    display: grid;
    gap: 1.1rem;
    width: 100%;
  }

  .pagev2-steps-container--resource {
    max-width: 760px;
  }

  .pagev2-steps--cards {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  }

  .pagev2-steps--two-by-two {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
  }

  .pagev2-steps--timeline {
    grid-template-columns: 1fr;
  }

  .pagev2-steps--resource {
    grid-template-columns: 1fr;
  }

  .pagev2-step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: .95rem;
    min-width: 0;
    padding: 1.2rem 1.25rem;
    border-radius: 8px;
    background: #fff;
    border: 1px solid rgba(226, 232, 240, .95);
    box-shadow: 0 10px 24px rgba(15, 23, 42, .035);
  }

  .pagev2-step__index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: #4f46e5;
    color: #fff;
    font-weight: 800;
  }

  .pagev2-step h3 {
    margin: 0;
    color: #0f172a;
    font-size: 1.02rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .pagev2-step p {
    margin: .45rem 0 0;
    color: #475569;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  @media (min-width: 1180px) {
    .pagev2-steps--cards:not(.pagev2-steps--resource) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .pagev2-steps--two-by-two:not(.pagev2-steps--resource) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
