---
import Base from '../layouts/Base.astro';
import CampaignPage from './CampaignPage.astro';
import BrandContentPage from './BrandContentPage.astro';
import ResourceHubPage from './ResourceHubPage.astro';
import HeroBlock from './page-v2/HeroBlock.astro';
import RichTextBlock from './page-v2/RichTextBlock.astro';
import ProofStatsBlock from './page-v2/ProofStatsBlock.astro';
import CardsGridBlock from './page-v2/CardsGridBlock.astro';
import FeatureListBlock from './page-v2/FeatureListBlock.astro';
import StepsBlock from './page-v2/StepsBlock.astro';
import FaqBlock from './page-v2/FaqBlock.astro';
import TestimonialBlock from './page-v2/TestimonialBlock.astro';
import RelatedLinksBlock from './page-v2/RelatedLinksBlock.astro';
import FinalCtaBlock from './page-v2/FinalCtaBlock.astro';
import PricingPlansBlock from './page-v2/PricingPlansBlock.astro';
import ComparisonTableBlock from './page-v2/ComparisonTableBlock.astro';
import BeforeAfterBlock from './page-v2/BeforeAfterBlock.astro';
import InternalLinksBlock from './page-v2/InternalLinksBlock.astro';
import { mapPageV2ToLegacyPage } from '../lib/page-v2-legacy-bridge';
import { withBasePath } from '../lib/urls';

const { page } = Astro.props as { page: Record<string, any> };
const sections = Array.isArray(page.sections) ? page.sections : [];
const firstBlockType = sections[0]?.block_type || '';
const toHref = (href?: string) => withBasePath(href);
const robots = typeof page.robots === 'string' && page.robots.trim()
  ? page.robots.replace(',', ', ')
  : 'index, follow';

const blockComponents: Record<string, any> = {
  hero: HeroBlock,
  'rich-text': RichTextBlock,
  'proof-stats': ProofStatsBlock,
  'cards-grid': CardsGridBlock,
  'feature-list': FeatureListBlock,
  steps: StepsBlock,
  faq: FaqBlock,
  testimonial: TestimonialBlock,
  'related-links': RelatedLinksBlock,
  'final-cta': FinalCtaBlock,
  'pricing-plans': PricingPlansBlock,
  'comparison-table': ComparisonTableBlock,
  'before-after': BeforeAfterBlock,
  'internal-links': InternalLinksBlock,
};

const familyComponents: Record<string, any> = {
  campaign: CampaignPage,
  brand: BrandContentPage,
  resource: ResourceHubPage,
};
const FamilyComponent = familyComponents[page.page_kind || ''];
const familyPage = FamilyComponent
  ? mapPageV2ToLegacyPage(page, page.page_kind as 'campaign' | 'brand' | 'resource')
  : null;
const forceV2Preview = Boolean(page.force_v2_preview);

const pageKindBreadcrumbMap: Record<string, { label: string; href: string }> = {
  campaign: { label: 'Кампании', href: '/site-map' },
  brand: { label: 'Бренды', href: '/site-map' },
  resource: { label: 'Ресурсы', href: '/site-map' },
  landing: { label: 'Страницы', href: '/site-map' },
  comparison: { label: 'Сравнения', href: '/site-map' },
};

const cleanLabel = (value?: string) => `${value || ''}`.trim();
const pageKindBreadcrumb = pageKindBreadcrumbMap[page.page_kind || ''] || pageKindBreadcrumbMap[page.nav_group || ''];
const parentBreadcrumb = page.parent_page?.route_path
  ? {
      label: cleanLabel(page.parent_page.nav_label || page.parent_page.title),
      href: page.parent_page.route_path,
    }
  : null;
const currentBreadcrumbLabel = cleanLabel(page.nav_label || page.title || page.seo_title);
const breadcrumbs = [
  { label: 'Главная', href: '/' },
  parentBreadcrumb || pageKindBreadcrumb,
  currentBreadcrumbLabel ? { label: currentBreadcrumbLabel } : null,
].filter((item) => item?.label);
const hasFinalCtaBlock = sections.some((section) => section?.block_type === 'final-cta');

const hasInternalLinksBlock = sections.some((section) => section?.block_type === 'internal-links');
const fallbackInternalLinks = !hasInternalLinksBlock && Array.isArray(page.internal_links) && page.internal_links.length > 0
  ? {
      block_type: 'internal-links',
      eyebrow: 'По теме страницы',
      title: page.internal_links_title || 'Что ещё посмотреть',
      intro: page.internal_links_intro || '',
      links: page.internal_links,
    }
  : null;
---

{FamilyComponent && familyPage && !forceV2Preview ? (
  <FamilyComponent page={familyPage} />
) : (
  <Base
    title={page.seo_title || page.title}
    description={page.seo_description}
    canonical={page.canonical}
    robots={robots}
    hideGlobalStickyCta={hasFinalCtaBlock}
  >
    <article class:list={[
      'pagev2-shell',
      `pagev2-shell--${page.template_variant || 'default'}`,
      `pagev2-shell--kind-${page.page_kind || 'page'}`,
    ]}>
    {breadcrumbs.length > 0 && firstBlockType !== 'hero' && (
      <section class="pagev2-breadcrumbs">
        <div class="container container-narrow">
          <nav aria-label="Хлебные крошки">
            <ol>
              {breadcrumbs.map((item, index) => (
                <li>
                  {item.href && index < breadcrumbs.length - 1 ? (
                    <a href={toHref(item.href)}>{item.label}</a>
                  ) : (
                    <span aria-current={index === breadcrumbs.length - 1 ? 'page' : undefined}>{item.label}</span>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        </div>
      </section>
    )}

    {firstBlockType !== 'hero' && (
      <section class="section pagev2-intro">
        <div class="container container-narrow">
          <span class="pagev2-intro__eyebrow">{page.page_kind}</span>
          <h1>{page.title}</h1>
          {page.seo_description && <p>{page.seo_description}</p>}
        </div>
      </section>
    )}

    {sections.map((section) => {
      const Component = blockComponents[section.block_type];
      if (!Component) {
        return null;
      }

      return (
        <Component
          section={section}
          templateVariant={page.template_variant}
          pageKind={page.page_kind}
          breadcrumbs={section.block_type === 'hero' ? breadcrumbs : undefined}
        />
      );
    })}

    {fallbackInternalLinks && <InternalLinksBlock section={fallbackInternalLinks} />}

    {sections.length === 0 && (
      <section class="section">
        <div class="container container-narrow pagev2-empty">
          <h2>Страница еще не собрана</h2>
          <p>Добавьте блоки в dynamic zone, чтобы контент появился на сайте.</p>
        </div>
      </section>
    )}
    </article>
  </Base>
)}

<style>
  .pagev2-shell--editorial,
  .pagev2-shell--minimal {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  }

  .pagev2-shell--showcase {
    background:
      radial-gradient(circle at top right, rgba(99, 102, 241, .08), transparent 22%),
      linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  }

  :global(.pagev2-shell--kind-campaign .section) {
    padding: clamp(3.2rem, 6vw, 4.8rem) 0;
  }

  :global(.pagev2-shell--kind-campaign .section-tonal) {
    background: linear-gradient(180deg, rgba(248, 250, 252, .92), rgba(255, 255, 255, .98));
    border-top: 1px solid rgba(148, 163, 184, .1);
    border-bottom: 1px solid rgba(148, 163, 184, .1);
  }

  :global(.pagev2-shell--kind-campaign .section-header) {
    max-width: 760px;
    margin-bottom: 1.45rem;
  }

  :global(.pagev2-shell--kind-campaign .section-header h2) {
    font-size: clamp(1.8rem, 3vw, 2.45rem);
    line-height: 1.05;
  }

  :global(.pagev2-shell--kind-resource .pagev2-hero),
  :global(.pagev2-shell--kind-brand .pagev2-hero) {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 56%, #155e75 100%);
  }

  .pagev2-breadcrumbs {
    padding: .9rem 0;
    border-bottom: 1px solid rgba(226, 232, 240, .88);
    background: rgba(255, 255, 255, .72);
  }

  .pagev2-breadcrumbs ol {
    display: flex;
    gap: .5rem;
    flex-wrap: wrap;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .pagev2-breadcrumbs li {
    color: #64748b;
    font-size: .82rem;
    line-height: 1.4;
  }

  .pagev2-breadcrumbs li + li::before {
    content: '/';
    margin-right: .5rem;
    color: #94a3b8;
  }

  .pagev2-breadcrumbs a {
    color: inherit;
  }

  .pagev2-breadcrumbs span[aria-current='page'] {
    color: #334155;
    font-weight: 700;
  }

  .pagev2-intro {
    padding-top: clamp(2.6rem, 5vw, 4rem);
  }

  .pagev2-intro__eyebrow {
    color: #4f46e5;
    font-size: .76rem;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .pagev2-intro h1 {
    margin: .8rem 0 0;
    color: #0f172a;
    font-size: clamp(2.2rem, 4.4vw, 3.6rem);
    line-height: 1;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }

  .pagev2-intro p {
    margin: 1rem 0 0;
    color: #475569;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .pagev2-empty {
    padding: 1.4rem;
    border-radius: 8px;
    background: #f8fafc;
    border: 1px dashed #cbd5e1;
  }

  .pagev2-empty h2 {
    margin: 0;
    color: #0f172a;
  }

  .pagev2-empty p {
    margin: .75rem 0 0;
    color: #475569;
  }
</style>
