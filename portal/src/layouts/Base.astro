---
import '../styles/global.css';
import '../styles/block-primitives.css';
import { getPageV2Pages, getSiteSettings } from '../lib/strapi';
import { getFooterColumns, getHeaderLinks, getMobileNavSections, isPathActive } from '../lib/navigation';
import { getRuntimeEnvValue } from '../lib/preview-auth';
import { getSearchAnalyticsConfig, isAnalyticsEnabled } from '../lib/search-analytics';
import { normalizeInternalPath, withBasePath } from '../lib/urls';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  robots?: string;
  hideGlobalStickyCta?: boolean;
}

const {
  title,
  description,
  image = '/og-image.png',
  canonical,
  robots = 'index, follow',
  hideGlobalStickyCta = false,
} = Astro.props;

const settings = await getSiteSettings();
const site = (Astro.site?.toString() || settings.site_url).replace(/\/$/, '');
const pathname = normalizeInternalPath(Astro.url.pathname);
const isDemoPreview = site.includes('github.io/chatplus');
const finalDescription = description || settings.default_description;
const canonicalURL = (isDemoPreview ? null : canonical) || new URL(pathname, `${site}/`).toString();
const ogImage = /^https?:\/\//.test(image) ? image : `${site}${image.startsWith('/') ? image : `/${image}`}`;
const ogImageType = ogImage.toLowerCase().endsWith('.png')
  ? 'image/png'
  : ogImage.toLowerCase().endsWith('.jpg') || ogImage.toLowerCase().endsWith('.jpeg')
    ? 'image/jpeg'
    : ogImage.toLowerCase().endsWith('.webp')
      ? 'image/webp'
      : ogImage.toLowerCase().endsWith('.svg')
        ? 'image/svg+xml'
        : undefined;
const siteName = settings.site_name?.trim() || 'Chat Plus';
const pageV2Pages = await getPageV2Pages();
const headerLinks = getHeaderLinks(settings.header_links, pageV2Pages);
const footerColumns = getFooterColumns(settings.footer_columns, pageV2Pages);
const mobileNavSections = getMobileNavSections(headerLinks, footerColumns);
const toHref = (href?: string) => withBasePath(href);
const configuredCmsPublicUrl = getRuntimeEnvValue('CMS_PUBLIC_URL') || getRuntimeEnvValue('PUBLIC_URL');
const cmsPublicUrl = (configuredCmsPublicUrl || 'https://strapi.integromat.ru').replace(/\/+$/, '');
const leadSubmitUrl = `${cmsPublicUrl}/api/lead-requests/submit`;
const leadFormFields = Array.isArray(settings.lead_form_fields) ? settings.lead_form_fields : [];
const normalizedTitle = (title || '').trim();
const fullTitle = normalizedTitle.endsWith(`| ${siteName}`) || normalizedTitle === siteName
  ? normalizedTitle
  : `${normalizedTitle} | ${siteName}`;

const orgSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: settings.site_name,
  url: site,
  logo: `${site}/favicon.svg`,
  description: settings.organization_description || settings.default_description,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    url: `${site}${settings.header_cta_url || '/demo'}`,
  },
});

const websiteSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: settings.site_name,
  url: site,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${site}/search?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
});

const analytics = getSearchAnalyticsConfig(import.meta.env || {});
const hasAnalytics = isAnalyticsEnabled(analytics);
const yandexMetrikaOptions = JSON.stringify({
  clickmap: true,
  trackLinks: true,
  accurateTrackBounce: true,
  webvisor: analytics.yandexMetrikaWebvisor,
});
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {import.meta.env.DEV && (
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
  )}
  <title>{fullTitle}</title>
  <meta name="description" content={finalDescription} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonicalURL} />
  {analytics.googleSiteVerification && (
    <meta name="google-site-verification" content={analytics.googleSiteVerification} />
  )}
  {analytics.yandexSiteVerification && (
    <meta name="yandex-verification" content={analytics.yandexSiteVerification} />
  )}

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={settings.site_name} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={finalDescription} />
  <meta property="og:image" content={ogImage} />
  {ogImageType && <meta property="og:image:type" content={ogImageType} />}
  <meta property="og:image:secure_url" content={ogImage} />
  <meta property="og:image:alt" content={fullTitle} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="ru_RU" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={finalDescription} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={fullTitle} />

  <link rel="icon" type="image/svg+xml" href={toHref('/favicon.svg')} />
  <link rel="icon" type="image/x-icon" href={toHref('/favicon.ico')} />
  <link rel="apple-touch-icon" href={toHref('/favicon.svg')} />

  <script type="application/ld+json" set:html={orgSchema} />
  <script type="application/ld+json" set:html={websiteSchema} />

  {analytics.googleTagManagerId && (
    <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${analytics.googleTagManagerId}');`} />
  )}
  {analytics.googleTagId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${analytics.googleTagId}`}></script>
      <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${analytics.googleTagId}');`} />
    </>
  )}
  {analytics.yandexMetrikaId && (
    <script is:inline set:html={`(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments);};m[i].l=1*new Date();for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a);})(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');ym(${analytics.yandexMetrikaId},'init',${yandexMetrikaOptions});`} />
  )}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <slot name="head" />
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>
    body {
      background:
        radial-gradient(circle at top left, rgba(99, 102, 241, .06), transparent 20%),
        linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
      overflow: visible;
      padding: 0 clamp(1rem, 3vw, 1.6rem);
      border-bottom: 1px solid rgba(226, 232, 240, .94);
      background: rgba(255,255,255,.88);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      box-shadow: 0 12px 28px rgba(15, 23, 42, .04);
    }

    .site-nav {
      max-width: var(--container);
      margin: 0 auto;
      min-height: 72px;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: clamp(1rem, 2vw, 1.35rem);
    }

    .brand-link {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: .75rem;
      padding: .55rem .9rem .55rem .2rem;
      border-radius: 999px;
      flex-shrink: 0;
      color: var(--text-main);
      font-size: 1.12rem;
      font-weight: 800;
      letter-spacing: -.03em;
      transition: transform .18s ease, background .18s ease;
    }

    .brand-link:hover {
      transform: translateY(-1px);
      background: rgba(255, 255, 255, .72);
    }

    .brand-link::before {
      content: '';
      width: 10px;
      height: 10px;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--brand), var(--brand-dark));
      box-shadow: 0 0 0 6px rgba(99, 102, 241, .09);
      flex-shrink: 0;
    }

    .nav-links-wrap {
      display: flex;
      gap: .2rem;
      align-items: center;
      justify-content: center;
      min-width: 0;
      padding: .28rem;
      border-radius: 18px;
      background: rgba(248, 250, 252, .82);
      border: 1px solid rgba(226, 232, 240, .9);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .75);
    }

    .nav-link {
      color: #475569;
      font-size: .94rem;
      font-weight: 600;
      line-height: 1;
      padding: .76rem .9rem;
      border-radius: 14px;
      transition: color .18s ease, background .18s ease, box-shadow .18s ease, transform .18s ease;
    }

    .nav-link:hover {
      color: var(--brand-dark);
      background: rgba(99, 102, 241, .06);
      transform: translateY(-1px);
    }

    .nav-link.is-active {
      color: var(--brand-dark);
      background: linear-gradient(135deg, rgba(99, 102, 241, .12), rgba(79, 70, 229, .08));
      box-shadow: inset 0 0 0 1px rgba(99, 102, 241, .12), 0 8px 20px rgba(99, 102, 241, .08);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: .75rem;
      flex-shrink: 0;
      justify-self: end;
    }

    .header-cta,
    .sticky-cta-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--brand), var(--brand-dark));
      color: #fff;
      font-weight: 700;
      font-size: .9rem;
      white-space: nowrap;
      box-shadow: var(--shadow-brand);
      transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
    }

    .header-cta {
      min-height: 42px;
      padding: .68rem 1.05rem;
      border-radius: 12px;
      font-size: .88rem;
    }

    .sticky-cta-button {
      padding: .62rem 1.15rem;
    }

    .header-cta:hover,
    .sticky-cta-button:hover {
      transform: translateY(-1px);
      filter: saturate(1.05);
      box-shadow: 0 14px 28px rgba(99, 102, 241, .18);
    }

    .nav-toggle {
      display: none;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border: 1px solid var(--border-main);
      border-radius: 12px;
      background: #fff;
      color: var(--text-main);
      cursor: pointer;
      transition: background .18s ease, border-color .18s ease;
    }

    .nav-toggle:hover {
      background: #f8fafc;
      border-color: #cbd5e1;
    }

    .mobile-nav-panel {
      display: none;
    }

    .site-footer {
      margin-top: 0;
      padding: clamp(3.2rem, 6vw, 5.2rem) clamp(1.25rem, 4vw, 2rem) 2rem;
      background:
        radial-gradient(circle at top center, rgba(99, 102, 241, .12), transparent 24%),
        linear-gradient(180deg, rgba(15, 23, 42, .22), transparent 18%),
        #0a0f1e;
      color: var(--text-muted);
    }

    .footer-inner {
      max-width: var(--container);
      margin: 0 auto;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: minmax(240px, 1.15fr) repeat(5, minmax(150px, 1fr));
      gap: 1.5rem clamp(1rem, 2vw, 1.7rem);
      align-items: start;
      margin-bottom: 2.6rem;
    }

    .footer-brand-block,
    .footer-column-card {
      display: grid;
      gap: .95rem;
      min-height: 0;
    }

    .footer-brand-block {
      position: relative;
      padding: .2rem 1.25rem .4rem 0;
      align-content: start;
    }

    .footer-brand-block::after {
      display: none;
    }

    .footer-column-card {
      padding: .25rem 0 0;
      align-content: start;
      border-top: none;
      min-width: 0;
    }

    .footer-brand {
      color: #fff;
      font-weight: 800;
      font-size: 1.55rem;
      letter-spacing: -.03em;
      line-height: 1.02;
      margin-bottom: .2rem;
    }

    .footer-tagline {
      max-width: 300px;
      font-size: .95rem;
      line-height: 1.78;
      color: var(--text-soft);
    }

    .footer-brand-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-height: 40px;
      margin-top: .35rem;
      padding: .7rem 1rem;
      border-radius: 12px;
      background: linear-gradient(135deg, rgba(99, 102, 241, .92), rgba(79, 70, 229, .96));
      color: #fff;
      font-size: .88rem;
      font-weight: 700;
      box-shadow: 0 12px 24px rgba(79, 70, 229, .18);
      transition: transform .18s ease, box-shadow .18s ease;
    }

    .footer-brand-cta:hover {
      transform: translateY(-1px);
      box-shadow: 0 16px 30px rgba(79, 70, 229, .22);
    }

    .footer-title {
      margin-bottom: .45rem;
      color: #e2e8f0;
      font-size: .78rem;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .footer-links {
      display: flex;
      flex-direction: column;
      gap: .62rem;
    }

    .footer-link {
      display: block;
      padding: 0;
      margin: 0;
      border-radius: 0;
      color: var(--text-soft);
      font-size: .95rem;
      transition: color .18s ease, transform .18s ease;
    }

    .footer-link:hover {
      color: #fff;
      transform: translateX(2px);
    }

    .footer-link-label {
      color: inherit;
      font-weight: 700;
      line-height: 1.35;
      overflow-wrap: anywhere;
    }

    .footer-bottom {
      border-top: 1px solid rgba(148, 163, 184, .14);
      padding-top: 1.35rem;
      color: #475569;
      font-size: .82rem;
    }

    .footer-bottom-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .footer-meta-links {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .footer-meta-link {
      color: #94a3b8;
      transition: color .18s ease;
    }

    .footer-meta-link:hover {
      color: #fff;
    }

    #sticky-cta {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: .95rem clamp(1rem, 4vw, 2rem);
      background: rgba(10, 15, 30, .88);
      border-top: 1px solid rgba(255,255,255,.08);
      backdrop-filter: blur(14px);
      color: #fff;
      transform: translateY(100%);
      transition: transform .35s cubic-bezier(.4,0,.2,1);
    }

    #sticky-cta.visible {
      transform: translateY(0);
    }

    .lead-modal {
      position: fixed;
      inset: 0;
      z-index: 220;
      display: grid;
      place-items: center;
      padding: 1.25rem;
      background: rgba(15, 23, 42, .58);
      opacity: 0;
      visibility: hidden;
      transition: opacity .2s ease, visibility .2s ease;
    }

    .lead-modal.is-open {
      opacity: 1;
      visibility: visible;
    }

    .lead-modal__dialog {
      width: min(100%, 520px);
      max-height: min(760px, calc(100vh - 2.5rem));
      overflow: auto;
      border-radius: 8px;
      background: #fff;
      box-shadow: 0 28px 70px rgba(15, 23, 42, .26);
      transform: translateY(12px);
      transition: transform .2s ease;
    }

    .lead-modal.is-open .lead-modal__dialog {
      transform: translateY(0);
    }

    .lead-modal.is-success .lead-modal__dialog {
      width: min(100%, 380px);
      max-height: calc(100vh - 2.5rem);
      overflow: visible;
    }

    .lead-modal.is-success .lead-modal__head {
      display: none;
    }

    .lead-modal__head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      padding: 1.35rem 1.35rem .75rem;
    }

    .lead-modal__head[hidden] {
      display: none !important;
    }

    .lead-modal__title {
      margin: 0;
      color: #0f172a;
      font-size: 1.45rem;
      line-height: 1.15;
      letter-spacing: 0;
    }

    .lead-modal__intro {
      margin: .55rem 0 0;
      color: #64748b;
      line-height: 1.65;
    }

    .lead-modal__close {
      width: 2.35rem;
      height: 2.35rem;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      background: #f8fafc;
      color: #475569;
      font-size: 1.4rem;
      line-height: 1;
      cursor: pointer;
      flex-shrink: 0;
    }

    .lead-form {
      display: grid;
      gap: .95rem;
      padding: .6rem 1.35rem 1.35rem;
    }

    .lead-form[hidden] {
      display: none !important;
    }

    .lead-form__field {
      display: grid;
      gap: .4rem;
    }

    .lead-form__label {
      color: #0f172a;
      font-size: .92rem;
      font-weight: 700;
    }

    .lead-form__label span {
      color: #ef4444;
    }

    .lead-form input,
    .lead-form textarea,
    .lead-form select {
      width: 100%;
      min-height: 46px;
      border: 1px solid #dbe3ef;
      border-radius: 8px;
      padding: .72rem .82rem;
      background: #fff;
      color: #0f172a;
      font: inherit;
    }

    .lead-form textarea {
      min-height: 112px;
      resize: vertical;
    }

    .lead-form__checkbox {
      display: flex;
      gap: .65rem;
      align-items: flex-start;
      color: #0f172a;
      font-weight: 700;
    }

    .lead-form__checkbox input {
      width: 1.05rem;
      min-height: 0;
      height: 1.05rem;
      margin-top: .18rem;
      flex-shrink: 0;
    }

    .lead-form__help {
      margin: 0;
      color: #64748b;
      font-size: .84rem;
      line-height: 1.45;
    }

    .lead-form__honeypot {
      position: absolute;
      left: -9999px;
      width: 1px;
      height: 1px;
      overflow: hidden;
    }

    .lead-form__submit {
      min-height: 48px;
      border: 0;
      border-radius: 8px;
      background: linear-gradient(135deg, var(--brand), var(--brand-dark));
      color: #fff;
      font-weight: 800;
      cursor: pointer;
      box-shadow: var(--shadow-brand);
    }

    .lead-form__submit:disabled {
      cursor: wait;
      opacity: .68;
      box-shadow: none;
    }

    .lead-form__status {
      min-height: 1.25rem;
      color: #475569;
      font-size: .92rem;
      line-height: 1.45;
    }

    .lead-form__status[data-state='success'] {
      color: #047857;
      font-weight: 700;
    }

    .lead-form__status[data-state='error'] {
      color: #dc2626;
      font-weight: 700;
    }

    .lead-success {
      display: grid;
      gap: .95rem;
      justify-items: center;
      padding: 1.7rem 1.35rem;
      text-align: center;
    }

    .lead-success[hidden] {
      display: none !important;
    }

    .lead-success__icon {
      display: grid;
      place-items: center;
      width: 3rem;
      height: 3rem;
      border-radius: 999px;
      background: #dcfce7;
      color: #047857;
      font-size: 1.65rem;
      font-weight: 900;
    }

    .lead-success__title {
      margin: 0;
      color: #0f172a;
      font-size: 1.3rem;
      line-height: 1.2;
      letter-spacing: 0;
    }

    .lead-success__text {
      margin: 0;
      color: #475569;
      line-height: 1.55;
    }

    .lead-success__close {
      width: 100%;
      min-height: 46px;
      border: 0;
      border-radius: 8px;
      background: linear-gradient(135deg, var(--brand), var(--brand-dark));
      color: #fff;
      font-weight: 800;
      cursor: pointer;
      box-shadow: var(--shadow-brand);
    }

    .sticky-cta-inner {
      width: 100%;
      max-width: var(--container);
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .sticky-cta-copy {
      display: grid;
      gap: .2rem;
    }

    .sticky-cta-kicker {
      color: #c7d2fe;
      font-size: .73rem;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .sticky-cta-text {
      color: var(--text-soft);
      font-size: .9rem;
      font-weight: 500;
      line-height: 1.5;
    }

    .sticky-cta-actions {
      display: flex;
      align-items: center;
      gap: .65rem;
      flex-shrink: 0;
    }

    .sticky-close {
      width: 34px;
      height: 34px;
      border: 0;
      border-radius: 10px;
      background: rgba(255,255,255,.08);
      color: var(--text-soft);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      transition: background .18s ease, color .18s ease;
    }

    .sticky-close:hover {
      background: rgba(255,255,255,.16);
      color: #fff;
    }

    @media (max-width: 1280px) {
      .footer-grid {
        grid-template-columns: minmax(220px, 1.2fr) repeat(3, minmax(180px, 1fr));
      }

      .footer-brand-block {
        grid-column: 1 / -1;
        padding: 0 0 1rem;
        border-bottom: 1px solid rgba(148, 163, 184, .12);
      }

      .footer-brand-block::after {
        display: none;
      }
    }

    @media (max-width: 1024px) {
      .footer-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.1rem 1rem;
      }

      .footer-brand-block {
        grid-column: 1 / -1;
        padding: 0 0 1rem;
        border-bottom: 1px solid rgba(148, 163, 184, .12);
      }

      .footer-column-card {
        padding-top: .35rem;
      }
    }

    @media (max-width: 1140px) {
      .site-nav {
        grid-template-columns: auto 1fr auto;
      }

      .nav-actions {
        margin-left: auto;
        justify-content: flex-end;
      }

      .nav-links-wrap {
        justify-content: flex-start;
        overflow-x: auto;
        scrollbar-width: none;
        background: transparent;
        border: 0;
        box-shadow: none;
        padding: 0;
      }

      .nav-links-wrap::-webkit-scrollbar {
        display: none;
      }
    }

    @media (max-width: 1140px) {
      .nav-links-wrap {
        display: none;
      }

      .nav-toggle {
        display: inline-flex;
        order: 2;
      }

      .header-cta {
        order: 1;
      }

      .mobile-nav-panel {
        position: absolute;
        top: calc(100% + .55rem);
        left: .95rem;
        right: .95rem;
        z-index: 120;
        display: grid;
        gap: 1rem;
        padding: 1rem;
        border: 1px solid var(--border-main);
        border-radius: 22px;
        background: rgba(255,255,255,.98);
        box-shadow: 0 24px 52px rgba(15, 23, 42, .14);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(-8px);
        transition: opacity .22s ease, transform .22s ease, visibility .22s ease;
      }

      .mobile-nav-panel.open {
        display: grid !important;
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(0);
      }

      .mobile-nav-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 46px;
        border-radius: 14px;
        background: linear-gradient(135deg, var(--brand), var(--brand-dark));
        color: #fff;
        font-size: .92rem;
        font-weight: 700;
        box-shadow: var(--shadow-brand);
      }

      .mobile-nav-sections {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .9rem;
      }

      .mobile-nav-section {
        display: grid;
        gap: .45rem;
        padding: .8rem;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        background: #f8fafc;
      }

      .mobile-nav-title {
        color: #64748b;
        font-size: .76rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
      }

      .mobile-nav-links {
        display: grid;
        gap: .15rem;
      }

      .mobile-nav-link {
        display: block;
        width: 100%;
        padding: .82rem .95rem;
        border-radius: 12px;
        color: #475569;
        font-size: .95rem;
        font-weight: 600;
        transition: color .18s ease, background .18s ease;
      }

      .mobile-nav-link:hover,
      .mobile-nav-link.is-active {
        color: var(--brand-dark);
        background: rgba(99, 102, 241, .06);
      }

      .sticky-cta-text,
      .sticky-cta-kicker {
        display: none;
      }

      .sticky-cta-inner {
        justify-content: center;
      }
    }

    @media (max-width: 520px) {
      .site-header {
        padding: 0 .9rem;
      }

      .site-nav {
        min-height: 62px;
      }

      .header-cta {
        display: none;
      }

      .footer-grid {
        grid-template-columns: 1fr;
        gap: 1rem;
      }

      .mobile-nav-panel {
        left: .7rem;
        right: .7rem;
        padding: .85rem;
      }

      .mobile-nav-sections {
        grid-template-columns: 1fr;
      }

      .footer-brand-block {
        padding-right: 0;
      }

      .footer-brand-block::after {
        display: none;
      }

      .footer-bottom-inner {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>
<body>
  {analytics.googleTagManagerId && (
    <noscript>
      <iframe src={`https://www.googletagmanager.com/ns.html?id=${analytics.googleTagManagerId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
  )}
  {analytics.yandexMetrikaId && (
    <noscript>
      <div>
        <img src={`https://mc.yandex.ru/watch/${analytics.yandexMetrikaId}`} style="position:absolute;left:-9999px;" alt="" />
      </div>
    </noscript>
  )}
  <header class="site-header" id="site-header">
    <nav class="site-nav">
      <a href={toHref('/')} class="brand-link">{settings.site_name}</a>
      <div class="nav-links-wrap">
        {headerLinks.map((link) => (
          <a href={toHref(link.href)} class:list={['nav-link', { 'is-active': isPathActive(pathname, link.href) }]}>{link.label}</a>
        ))}
      </div>
      <div class="nav-actions">
        <a href={toHref(settings.header_cta_url)} class="header-cta" data-analytics-event="cta_try_click" data-analytics-location="header">{settings.header_cta_label}</a>
        <button id="nav-toggle" type="button" class="nav-toggle" aria-label="Меню" aria-controls="mobile-nav" aria-expanded="false">
          <svg id="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          <svg id="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </nav>
    <div id="mobile-nav" class="mobile-nav-panel">
      <a href={toHref(settings.header_cta_url)} class="mobile-nav-cta" data-analytics-event="cta_try_click" data-analytics-location="mobile_nav">{settings.header_cta_label}</a>
      <div class="mobile-nav-sections">
        {mobileNavSections.map((section) => (
          <section class="mobile-nav-section">
            <p class="mobile-nav-title">{section.title}</p>
            <div class="mobile-nav-links">
              {section.links.map((link) => (
                <a href={toHref(link.href)} class:list={['mobile-nav-link', { 'is-active': isPathActive(pathname, link.href) }]}>{link.label}</a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-grid">
        <div class="footer-brand-block">
          <p class="footer-brand">{settings.site_name}</p>
          <p class="footer-tagline">{settings.footer_tagline}</p>
          <a href={toHref(settings.header_cta_url)} class="footer-brand-cta" data-analytics-event="cta_try_click" data-analytics-location="footer">{settings.header_cta_label}</a>
        </div>
        {footerColumns.map((column) => (
          <div class="footer-column-card">
            <p class="footer-title">{column.title}</p>
            <div class="footer-links">
              {column.links.map((link) => (
                <a href={toHref(link.href)} class="footer-link">
                  <span class="footer-link-label">{link.label}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
      <div class="footer-bottom">
        <div class="footer-bottom-inner">
          <span>{settings.footer_copyright}</span>
          <div class="footer-meta-links">
            <a href={toHref('/site-map')} class="footer-meta-link">Карта сайта</a>
          </div>
        </div>
      </div>
    </div>
  </footer>

  {!hideGlobalStickyCta && (
    <div id="sticky-cta">
      <div class="sticky-cta-inner">
        <div class="sticky-cta-copy">
          <span class="sticky-cta-kicker">Быстрый следующий шаг</span>
          <p class="sticky-cta-text">{settings.sticky_cta_text}</p>
        </div>
        <div class="sticky-cta-actions">
          <a href={toHref(settings.sticky_cta_url)} class="sticky-cta-button" data-analytics-event="cta_try_click" data-analytics-location="sticky_cta">{settings.sticky_cta_label}</a>
          <button id="close-sticky" class="sticky-close" aria-label="Закрыть">&times;</button>
        </div>
      </div>
    </div>
  )}

  {leadFormFields.length > 0 && (
    <div id="lead-modal" class="lead-modal" role="dialog" aria-modal="true" aria-labelledby="lead-modal-title" aria-hidden="true">
      <div class="lead-modal__dialog" data-lead-dialog>
        <div class="lead-modal__head">
          <div>
            <h2 id="lead-modal-title" class="lead-modal__title">{settings.lead_form_title}</h2>
            {settings.lead_form_intro && <p class="lead-modal__intro">{settings.lead_form_intro}</p>}
          </div>
          <button type="button" class="lead-modal__close" data-lead-close aria-label="Закрыть">&times;</button>
        </div>
        <form id="global-lead-form" class="lead-form" data-lead-form data-analytics-location="lead_modal">
          <input class="lead-form__honeypot" type="text" name="website" autocomplete="off" tabindex="-1" aria-hidden="true" />
          {leadFormFields.map((field) => (
            <div class="lead-form__field">
              {field.type === 'checkbox' ? (
                <label class="lead-form__checkbox">
                  <input type="checkbox" name={field.key} required={field.required} />
                  <span>{field.label}{field.required && <span> *</span>}</span>
                </label>
              ) : (
                <>
                  <label class="lead-form__label" for={`lead-${field.key}`}>
                    {field.label}{field.required && <span> *</span>}
                  </label>
                  {field.type === 'textarea' ? (
                    <textarea id={`lead-${field.key}`} name={field.key} placeholder={field.placeholder} required={field.required}></textarea>
                  ) : field.type === 'select' ? (
                    <select id={`lead-${field.key}`} name={field.key} required={field.required}>
                      <option value="">Выберите вариант</option>
                      {field.options.map((option) => <option value={option}>{option}</option>)}
                    </select>
                  ) : (
                    <input id={`lead-${field.key}`} name={field.key} type={field.type} placeholder={field.placeholder} required={field.required} />
                  )}
                </>
              )}
              {field.help_text && <p class="lead-form__help">{field.help_text}</p>}
            </div>
          ))}
          <button class="lead-form__submit" type="submit">{settings.lead_form_submit_label}</button>
          <div class="lead-form__status" data-lead-status aria-live="polite"></div>
        </form>
        <div class="lead-success" data-lead-success hidden>
          <div class="lead-success__icon" aria-hidden="true">✓</div>
          <h3 class="lead-success__title">Все прошло успешно</h3>
          <p class="lead-success__text">{settings.lead_form_success_text}</p>
          <button type="button" class="lead-success__close" data-lead-close>Закрыть форму</button>
        </div>
      </div>
    </div>
  )}

  <script is:inline define:vars={{
    analyticsYandexMetrikaId: analytics.yandexMetrikaId ? Number(analytics.yandexMetrikaId) : null,
    analyticsEnabled: hasAnalytics,
    leadSubmitUrl,
    leadSuccessText: settings.lead_form_success_text,
  }}>
    (function () {
      window.chatplusTrack = function (eventName, params) {
        const safeName = String(eventName || '').trim();
        if (!safeName || !analyticsEnabled) return;

        const payload = Object.assign({
          page_path: window.location.pathname,
          page_title: document.title,
        }, params || {});

        if (analyticsYandexMetrikaId && typeof window.ym === 'function') {
          window.ym(analyticsYandexMetrikaId, 'reachGoal', safeName, payload);
        }

        if (typeof window.gtag === 'function') {
          window.gtag('event', safeName, payload);
        } else if (Array.isArray(window.dataLayer)) {
          window.dataLayer.push(Object.assign({ event: safeName }, payload));
        }
      };

      document.addEventListener('click', function (event) {
        const target = event.target && event.target.closest
          ? event.target.closest('[data-analytics-event]')
          : null;
        if (!target) return;

        window.chatplusTrack(target.dataset.analyticsEvent, {
          location: target.dataset.analyticsLocation || undefined,
          href: target.href || undefined,
          text: (target.textContent || '').trim().slice(0, 120),
        });
      });

      document.addEventListener('submit', function (event) {
        const form = event.target;
        if (!form || !form.matches || !form.matches('[data-analytics-event]')) return;

        window.chatplusTrack(form.dataset.analyticsEvent || 'lead_submit', {
          location: form.dataset.analyticsLocation || 'form',
          form_id: form.id || undefined,
        });
      }, true);
    })();

    (function () {
      const modal = document.getElementById('lead-modal');
      const form = document.querySelector('[data-lead-form]');
      const status = document.querySelector('[data-lead-status]');
      const success = document.querySelector('[data-lead-success]');
      const head = modal.querySelector('.lead-modal__head');
      const closeButtons = document.querySelectorAll('[data-lead-close]');
      if (!modal || !form) return;

      function getAttribution() {
        const params = new URLSearchParams(window.location.search);
        const utm = {};
        params.forEach(function (value, key) {
          const normalizedKey = String(key || '').trim().toLowerCase();
          if (normalizedKey.indexOf('utm_') === 0 || normalizedKey === 'yclid' || normalizedKey === 'gclid') {
            utm[normalizedKey] = String(value || '').trim().slice(0, 500);
          }
        });

        return {
          source_url: window.location.href,
          source_query: window.location.search,
          referrer: document.referrer || '',
          utm,
        };
      }

      function setStatus(message, state) {
        if (!status) return;
        status.textContent = message || '';
        if (state) {
          status.dataset.state = state;
        } else {
          delete status.dataset.state;
        }
      }

      function showFormState() {
        modal.classList.remove('is-success');
        form.hidden = false;
        if (head) head.hidden = false;
        if (success) success.hidden = true;
        setStatus('', '');
      }

      function showSuccessState() {
        form.hidden = true;
        if (head) head.hidden = true;
        if (success) success.hidden = false;
        modal.classList.add('is-success');
        const closeButton = success ? success.querySelector('[data-lead-close]') : null;
        if (closeButton && closeButton.focus) closeButton.focus();
      }

      function openModal() {
        showFormState();
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        setTimeout(function () {
          const firstInput = modal.querySelector('input:not([type="hidden"]):not([aria-hidden="true"]), textarea, select, button');
          if (firstInput && firstInput.focus) firstInput.focus();
        }, 30);
        window.chatplusTrack('lead_modal_open', { location: 'cta' });
      }

      function closeModal() {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        window.setTimeout(showFormState, 180);
      }

      document.addEventListener('click', function (event) {
        const trigger = event.target && event.target.closest
          ? event.target.closest('a[href="modal:lead"], [data-lead-modal]')
          : null;
        const selfDemoLink = !trigger && window.location.pathname.replace(/\/+$/, '') === '/demo' && event.target && event.target.closest
          ? event.target.closest('a[href="/demo"], a[href="/demo/"]')
          : null;
        const selfDemoLeadLink = selfDemoLink && /записаться\s+на\s+демо/i.test((selfDemoLink.textContent || '').trim());
        if (!trigger && !selfDemoLeadLink) return;
        event.preventDefault();
        openModal();
      });

      modal.addEventListener('click', function (event) {
        if (event.target === modal) closeModal();
      });

      closeButtons.forEach(function (button) {
        button.addEventListener('click', closeModal);
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
      });

      form.addEventListener('submit', async function (event) {
        event.preventDefault();
        const submit = form.querySelector('button[type="submit"]');
        const formData = new FormData(form);
        const fields = {};
        form.querySelectorAll('[name]').forEach(function (input) {
          const name = input.getAttribute('name');
          if (!name || name === 'website') return;
          if (input.type === 'checkbox') {
            fields[name] = Boolean(input.checked);
          } else {
            fields[name] = String(formData.get(name) || '').trim();
          }
        });

        if (submit) submit.disabled = true;
        setStatus('Отправляем заявку...', '');

        try {
          const response = await fetch(leadSubmitUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              form_id: form.id || 'global-lead-form',
              source_path: window.location.pathname,
              source_title: document.title,
              attribution: getAttribution(),
              website: String(formData.get('website') || ''),
              fields,
            }),
          });
          const result = await response.json().catch(function () { return {}; });
          if (!response.ok || result.ok === false) {
            throw new Error(result.error || 'submit_failed');
          }

          form.reset();
          setStatus('', '');
          showSuccessState();
          window.chatplusTrack('lead_submit', { location: 'lead_modal' });
          window.chatplusTrack('lead_submit_success', { location: 'lead_modal' });
        } catch (error) {
          setStatus('Не получилось отправить. Проверьте поля или попробуйте позже.', 'error');
          window.chatplusTrack('lead_submit_error', { location: 'lead_modal' });
        } finally {
          if (submit) submit.disabled = false;
        }
      });
    })();

    (function () {
      const toggle = document.getElementById('nav-toggle');
      const menu = document.getElementById('mobile-nav');
      const iconMenu = document.getElementById('icon-menu');
      const iconClose = document.getElementById('icon-close');
      if (!toggle || !menu || !iconMenu || !iconClose) return;

      function openMenu() {
        menu.classList.add('open');
        toggle.setAttribute('aria-expanded', 'true');
        iconMenu.style.display = 'none';
        iconClose.style.display = '';
        document.addEventListener('click', onOutsideClick);
        document.addEventListener('keydown', onEscape);
      }

      function closeMenu() {
        menu.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        iconMenu.style.display = '';
        iconClose.style.display = 'none';
        document.removeEventListener('click', onOutsideClick);
        document.removeEventListener('keydown', onEscape);
      }

      function onOutsideClick(e) {
        if (!menu.contains(e.target) && !toggle.contains(e.target)) closeMenu();
      }

      function onEscape(e) {
        if (e.key === 'Escape') closeMenu();
      }

      toggle.addEventListener('click', function (e) {
        e.stopPropagation();
        menu.classList.contains('open') ? closeMenu() : openMenu();
      });

      menu.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', closeMenu);
      });

      window.addEventListener('resize', function () {
        if (window.innerWidth > 1140) closeMenu();
      }, { passive: true });
    })();

    (function () {
      const bar = document.getElementById('sticky-cta');
      const btn = document.getElementById('close-sticky');
      if (!bar || !btn) return;
      if (sessionStorage.getItem('cta-off')) return;
      const show = () => {
        if (window.scrollY > 400) {
          bar.classList.add('visible');
          window.removeEventListener('scroll', show);
        }
      };
      window.addEventListener('scroll', show, { passive: true });
      btn.addEventListener('click', () => {
        bar.classList.remove('visible');
        sessionStorage.setItem('cta-off', '1');
      });
    })();

    (function () {
      const obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.style.opacity = '1';
            entry.target.style.transform = 'translateY(0)';
            obs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.07 });

      document.querySelectorAll('main section').forEach(function (section, index) {
        if (index === 0) return;
        section.style.opacity = '0';
        section.style.transform = 'translateY(28px)';
        section.style.transition = 'opacity 0.65s ease, transform 0.65s ease';
        obs.observe(section);
      });
    })();

    (function () {
      const els = document.querySelectorAll('[data-count]');
      if (!els.length) return;

      const obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;

          const el = entry.target;
          const target = +el.dataset.count;
          const start = performance.now();
          const duration = 1600;

          function frame(now) {
            const t = Math.min((now - start) / duration, 1);
            const ease = t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
            el.textContent = Math.round(ease * target).toLocaleString('ru');
            if (t < 1) requestAnimationFrame(frame);
          }

          requestAnimationFrame(frame);
          obs.unobserve(el);
        });
      }, { threshold: 0.5 });

      els.forEach(function (el) {
        obs.observe(el);
      });
    })();
  </script>
</body>
</html>


