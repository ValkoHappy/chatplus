# Railway Strapi service variables.
# Do not commit real secrets. Fill these in Railway Variables UI.

NODE_ENV=production
HOST=0.0.0.0

# Railway provides PORT automatically.
# Strapi reads PORT from env through cms/config/server.ts.
PORT=${{PORT}}

# Use the Railway-generated Strapi domain first, then replace with custom domain later.
# Example: https://chatplus-strapi-production.up.railway.app
PUBLIC_URL=https://REPLACE_WITH_RAILWAY_STRAPI_DOMAIN
CMS_PUBLIC_URL=https://REPLACE_WITH_RAILWAY_STRAPI_DOMAIN

# Public Portal URL. Use Railway domain first, then custom domain later.
# Example: https://chatplus-portal-production.up.railway.app
PUBLIC_SITE_URL=https://REPLACE_WITH_RAILWAY_PORTAL_DOMAIN
PUBLIC_BASE_PATH=

# Railway Postgres.
# Replace "Postgres" with the actual Railway database service name if different.
DATABASE_CLIENT=postgres
DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_SCHEMA=public
DATABASE_SSL=false

# Strapi secrets. For a real migration, copy the production values from the current server
# or rotate them in a controlled maintenance window.
APP_KEYS=replace-me-1,replace-me-2,replace-me-3,replace-me-4
API_TOKEN_SALT=replace-with-random-string
ADMIN_JWT_SECRET=replace-with-random-string
TRANSFER_TOKEN_SALT=replace-with-random-string
JWT_SECRET=replace-with-random-string
ENCRYPTION_KEY=replace-with-random-string

# Preview and publish/rebuild integration.
PREVIEW_TOKEN=replace-with-random-preview-token
WEBHOOK_TOKEN=replace-with-shared-token-if-you-configure-webhooks

# Uploads/media storage.
# Mount a Railway Volume to /app/cms/public/uploads when using local upload storage.
UPLOAD_PROVIDER=local
CDN_URL=
CDN_ROOT_PATH=
AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET=
AWS_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_FORCE_PATH_STYLE=false
AWS_ACL=public-read
AWS_SIGNED_URL_EXPIRES=900
AWS_BUCKET_PUBLIC_URL=

# AI draft generation for page_v2 jobs.
# Direct DeepSeek example:
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenRouter + DeepSeek example:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# Generic OpenAI-compatible provider override:
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Backward-compatible direct OpenAI variables:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
