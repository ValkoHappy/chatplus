# Railway Portal service variables.
# Do not commit real tokens. Fill these in Railway Variables UI.

NODE_ENV=production
HOST=0.0.0.0

# Railway provides PORT automatically.
PORT=${{PORT}}

# Strapi API URL. Use the public Railway Strapi URL first.
# After both services are stable, this may be changed to Railway private networking.
# Example: https://chatplus-strapi-production.up.railway.app
STRAPI_URL=https://REPLACE_WITH_RAILWAY_STRAPI_DOMAIN

# Create this token in Strapi: Settings -> API Tokens.
STRAPI_TOKEN=replace-with-strapi-api-token

# Must match the Strapi PREVIEW_TOKEN.
PREVIEW_TOKEN=replace-with-random-preview-token

# Public Portal URL. Use Railway domain first, then custom domain later.
# Example: https://chatplus-portal-production.up.railway.app
PUBLIC_SITE_URL=https://REPLACE_WITH_RAILWAY_PORTAL_DOMAIN
PUBLIC_BASE_PATH=
